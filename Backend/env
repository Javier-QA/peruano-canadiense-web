# ============================================================================
# .env de PRODUCCIÓN (cPanel) — IESPP Peruano Canadiense
#
# Súbalo por el File Manager de cPanel, NUNCA por git, y renómbrelo a `.env`
# en la raíz de la aplicación Node (junto a server.js).
#
# Después de rellenarlo, borre este archivo de ejemplo del servidor.
# ============================================================================
# --- Servidor ---------------------------------------------------------------
# SIN línea PORT: Passenger asigna el puerto. Si la fija, la app no arranca.
NODE_ENV=production
# Orígenes que pueden llamar al API desde un navegador. Con y sin www, y
# http por si AutoSSL aún no redirige. Si omite esta línea en production,
# el backend usa estos mismos cuatro orígenes por defecto.
CORS_ORIGINS=https://pcanadiense.edu.pe,https://www.pcanadiense.edu.pe,http://pcanadiense.edu.pe,http://www.pcanadiense.edu.pe
# --- Base de datos ----------------------------------------------------------
# La cuenta de cPanel es `pcanad`, así que cPanel antepone `pcanad_` a la base y
# al usuario: si en el formulario escribe "portal", el usuario real es
# `pcanad_portal`. Cópielos tal cual salen en "MySQL Databases".
DB_HOST=localhost
DB_PORT=3306
DB_USER=pcanad_Soporte
DB_PASSWORD=ZKsZjN3!ZpMs0KcR5Dqz
DB_NAME=pcanad_pcanadiense
# --- Sesión -----------------------------------------------------------------
# Cadena larga y aleatoria, distinta de la de desarrollo. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas del panel.
JWT_SECRET=BPacpRuGzB4xfwnz0aPJhjxlZv80B1TfaA_9emnPr_1YfeR6rTUGvZv-fBVA8z76
JWT_EXPIRA=8h
# --- Archivos subidos -------------------------------------------------------
# FUERA del Application root (un redespliegue borraría los expedientes) y FUERA
# de public_html (Apache los serviría sin pasar por el control de acceso del
# API, y los adjuntos de mesa de partes llevan el DNI del ciudadano).
# Créela por SSH o File Manager y déjela en 700:
#   mkdir -p /home/pcanad/almacen_pcanadiense && chmod 700 /home/pcanad/almacen_pcanadiense
ALMACEN_DIR=/home/pcanad/almacen_pcanadiense
MAX_MB_IMAGEN=5
MAX_MB_PDF=15
# --- Correo -----------------------------------------------------------------
# Sin la clave de la casilla, deje MAIL_HABILITADO=false: el trámite se guarda
# igual; no se envía acuse ni aviso al solicitante.
# Cuando tenga la clave (cPanel → Email Accounts → Change Password):
#   MAIL_HABILITADO=true y MAIL_PASSWORD=esa-clave, luego Restart.
MAIL_HABILITADO=true
MAIL_HOST=mail.pcanadiense.edu.pe
MAIL_PORT=465
MAIL_SEGURO=true
